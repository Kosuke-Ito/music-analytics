  "annotations": [
    {
      "date": "2026-03-26",
      "title": "iHeartRadioミュージック・アワード2026で7冠を達成",
      "description": "テイラー・スウィフトが3月26日開催のiHeartRadioミュージック・アワード2026でアーティスト・オブ・ザ・イヤーを含む7部門を制覇し、同賞の通算受賞数を41冠に更新した。",
      "url": "https://www.billboard.com/music/awards/taylor-swift-2026-iheartradio-music-award-artist-of-the-year-1236208165/",
      "category": "award",
      "added_at": "2026-04-06T00:00:00+00:00"
    },
    {
      "date": "2026-03-31",
      "title": "「Elizabeth Taylor」ミュージックビデオをサプライズ公開",
      "description": "テイラー・スウィフトがアルバム『The Life of a Showgirl』収録曲「Elizabeth Taylor」のMVをApple MusicおよびSpotifyにてサプライズリリース。往年のハリウッド女優エリザベス・テイラーのアーカイブ映像で構成されたトリビュート映像となっている。",
      "url": "https://variety.com/2026/music/news/taylor-swift-elizabeth-taylor-music-video-1236703350/",
      "category": "release",
      "added_at": "2026-04-06T00:00:00+00:00"
    },
    {
      "date": "2026-04-07",
      "title": "「6月ロードアイランドで結婚式」のデマがセレブ専門ウェディングプランナーにより否定",
      "description": "テイラー・スウィフトとトラヴィス・ケルシーが6月にロードアイランドで挙式するという情報がSNSで拡散したが、4月7日にセレブ専門ウェディングプランナーが公式に否定。ファンの間でトレンドとなった。",
      "url": "https://www.realitytea.com/2026/04/07/taylor-swift-wedding-date-venue-rumor-debunked/",
      "category": "viral",
      "added_at": "2026-04-08T03:30:00+00:00",
      "source": "realitytea.com",
      "confidence": "medium",
      "verified": false
    },
    {
      "date": "2026-04-14",
      "title": "第52回AMAsでアルバム「The Life of a Showgirl」含む8部門でノミネートトップに",
      "description": "2026年のアメリカン・ミュージック・アワード（AMA）ノミネートが発表され、テイラー・スウィフトが年間最優秀アーティスト・アルバム「The Life of a Showgirl」・楽曲「The Fate of Ophelia」など8部門でトップを獲得。授賞式は5月25日にラスベガスのMGMグランド・ガーデン・アリーナで開催予定（Variety報道）。",
      "url": "https://variety.com/2026/music/news/taylor-swift-american-music-awards-nominations-sombr-amas-1236720959/",
      "category": "award",
      "added_at": "2026-04-16T03:00:00+00:00",
      "source": "variety.com",
      "confidence": "medium",
      "verified": false
    },
    {
      "date": "2026-04-18",
      "title": "Record Store Day 2026限定7インチビニール「Elizabeth Taylor」リリース",
      "description": "Record Store Day 2026（4月18日）に、アルバム『The Life of a Showgirl』収録曲「Elizabeth Taylor」のギャラクシーパープル・グリッターカラー7インチビニールを独立系レコード店限定でリリース。B面にはSo Glamorous Cabaret Versionを収録し、全国の参加レコード店のみで販売（billboard.com・recordstoreday.com報道）。",
      "url": "https://www.billboard.com/music/music-news/taylor-swift-2026-record-store-day-vinyl-showgirl-single-1236189791/",
      "category": "release",
      "added_at": "2026-04-18T00:00:00Z",
      "source": "billboard.com",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-20",
      "title": "American Idol「Taylor Swift Night」4月27日開催決定、Nikki Glaserがゲスト審査員に",
      "description": "4月20日放送のAmerican Idolで、トップ7がTaylor Swiftの楽曲を歌うTaylor Swift Nightを4月27日に開催すると発表。コメディアンでSwiftの大ファンであるNikki Glaserがゲスト審査員を務める。",
      "url": "https://www.billboard.com/culture/tv-film/taylor-swift-night-american-idol-top-7-singers-1236227532/",
      "category": "other",
      "added_at": "2026-04-21T00:00:00+00:00",
