  "annotations": [
    {
      "date": "2026-04-04",
      "title": "新曲「ふり」配信リリース＆MV公開",
      "description": "MAISONdesと関連する日曜日のメゾンデが漫画「アイツノカノジョ」原作の新曲「ふり」を4月4日に配信リリース。作詞・作曲はボカロP・大漠波新が担当し、同日20時よりYouTubeでMVのプレミア公開も実施された。",
      "url": "https://www.thefirsttimes.jp/news/0000595395/",
      "category": "release",
      "added_at": "2026-04-14T03:00:00+00:00",
      "source": "thefirsttimes.jp",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-11",
      "title": "渋谷都市型フェス「SYNCHRONICITY'26」に出演",
      "description": "渋谷で開催される都市型音楽フェスティバル「SYNCHRONICITY'26」（4月11〜12日）に4月11日（土）clubasiaにて出演。MAISONdesとも関連の深い日曜日のメゾンデが同フェスに参加した。",
      "url": "https://synchronicity.tv/festival/news/260225/",
