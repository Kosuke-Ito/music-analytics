  "annotations": [
    {
      "date": "2026-04-05",
      "title": "「パッパパラダイス」がちびまる子ちゃんEDテーマとして正規放送開始",
      "description": "宇多田ヒカルの新曲「パッパパラダイス」がアニメ「ちびまる子ちゃん」の新エンディング主題歌として4月5日から正規オンエア開始。ノンクレジットED映像はYouTubeで公開後に急速に再生数を伸ばした（bezzy.jp報道）。",
      "url": "https://bezzy.jp/2026/04/83841/",
      "category": "release",
      "added_at": "2026-04-14T03:00:00+00:00",
      "source": "bezzy.jp",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-10",
      "title": "「Utada」名義2アルバムの初リマスター＆LP化決定を発表",
      "description": "宇多田ヒカルが英語圏向け「Utada」名義で発表した『エキソドス』（2004）と『ディス・イズ・ザ・ワン』（2009）が初リマスターされ、6月24日にLP・SHM-CD・デジタルでリリースされることが発表された（ユニバーサルミュージック公式報道）。",
      "url": "https://www.universal-music.co.jp/utada-hikaru/news/2026-04-10/",
      "category": "release",
      "added_at": "2026-04-13T03:00:00+00:00",
      "source": "universal-music.co.jp",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-23",
      "title": "新曲「パッパパラダイス」ジャケットビジュアル解禁・6月7インチアナログ盤リリース発表",
      "description": "5月6日配信予定の新曲「パッパパラダイス」（アニメ「ちびまる子ちゃん」新ED・綾鷹CMソング）のジャケットビジュアルが解禁。6月24日に7インチアナログ盤リリースも発表された。",
      "url": "https://www.billboard-japan.com/d_news/detail/160408/2",
      "category": "release",
      "added_at": "2026-04-24T00:00:00+00:00",
      "source": "billboard-japan.com",
      "confidence": "medium",
      "verified": false
    }
  ],
