  "annotations": [
    {
      "date": "2026-04-02",
      "title": "ソーファイ・スタジアム公演でローリン・ヒルらをサプライズゲストに迎え44曲を披露",
      "description": "Yeはロサンゼルスのソーファイ・スタジアムで「Homecoming」コンサートの第2夜を開催し、トラヴィス・スコット、ローリン・ヒル、シーロー・グリーンら豪華ゲストを招いて計44曲を披露した。アルバム『Bully』プロモーションツアーの一環として5年ぶりの国内ライブ復帰となった。",
      "url": "https://www.rollingstone.com/music/music-live-reviews/kanye-ye-west-los-angeles-comeback-concert-2026-1235540823/",
      "category": "tour",
      "added_at": "2026-04-05T00:00:00+00:00"
    },
    {
      "date": "2026-04-05",
      "title": "アルバム「BULLY」がBillboard 200で2位にデビュー（初週15.2万ユニット）",
      "description": "Yeのアルバム「BULLY」がBillboard 200（4月5日付）で15万2000ユニット（純売上5万6000枚）を記録し2位にデビュー。14作連続のトップ2入りとなった。首位はBTSの「ARIRANG」。",
      "url": "https://ratingsgamemusic.com/2026/04/05/billboard-200-bully-arirang-adl/",
      "category": "award",
      "added_at": "2026-04-06T00:00:00+00:00"
    },
    {
      "date": "2026-04-07",
      "title": "英国が入国を拒否、Wirelessフェスティバルが中止に",
      "description": "英国政府がYeの電子渡航認証（ETA）を取り消し入国を禁止したため、ヘッドライナーとして予定されていたWireless Festival（3日間）が中止となった。スポンサーのPepsiとDiageoも反ユダヤ的発言をめぐる論争を受け既に撤退していた。",
      "url": "https://www.npr.org/2026/04/07/nx-s1-5776646/ye-kanye-west-travel-ban-uk-wireless",
      "category": "other",
      "added_at": "2026-04-08T03:30:00+00:00",
      "source": "npr.org",
      "confidence": "high",
      "verified": false
    }
  ],
