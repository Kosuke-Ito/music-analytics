  "annotations": [
    {
      "date": "2026-02-06",
      "title": "10周年記念シングル「Warm on a Cold Night (10 Years)」リリース＆アルバム「HONNE - 10」発表",
      "description": "デビュー10周年を記念したリイマジンアルバム「HONNE - 10」（5月15日発売）を発表し、先行シングルとしてデビュー曲「Warm on a Cold Night」の再録バージョン「Warm on a Cold Night (10 Years)」をリリース。ストリップドダウンのアコースティックアレンジで感情的な深みを強調した作品となった。",
      "url": "https://www.lionheartv.net/2026/02/honne-announce-honne-10-a-10-year-anniversary-reimagined-album-out-may-15-first-newly-re-recorded-single-warm-on-a-cold-night-10-years-out-now/",
      "category": "release",
      "added_at": "2026-04-18T00:00:00Z",
      "source": "lionheartv.net",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-03-06",
      "title": "NIKIとのコラボ再録曲「Location Unknown (10 Years)」リリース",
      "description": "HONNEが10周年プロジェクトの第2弾シングルとして、NIKIをフィーチャーした「Location Unknown (10 Years)」を配信。インドネシア出身シンガーNIKIの参加により、アジアのファン層からも大きな反響を呼んだ（pop.inquirer.net報道）。",
      "url": "https://pop.inquirer.net/381377/honne-and-niki-collaborate-on-new-version-of-location-unknown-for-honnes-10th-anniversary",
      "category": "release",
      "added_at": "2026-04-18T00:00:00Z",
      "source": "pop.inquirer.net",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-03",
      "title": "Izzy Bizuとの再録曲「Someone That Loves You (10 Years)」リリース",
      "description": "10周年記念プロジェクト「HONNE - 10」の第3弾シングルとして、Izzy Bizuをフィーチャーした「Someone That Loves You (10 Years)」を配信。オリジナルの豊かなシンセサイザーのテクスチャーをそぎ落とし、よりミニマルでアコースティックなアレンジに仕上げた（sports.khan.co.kr報道）。",
      "url": "https://sports.khan.co.kr/en/article/202604032323007/",
      "category": "release",
      "added_at": "2026-04-18T00:00:00Z",
      "source": "sports.khan.co.kr",
      "confidence": "high",
      "verified": false
    }
  ],
