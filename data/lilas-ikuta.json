  "annotations": [
    {
      "date": "2026-04-04",
      "title": "アニメ「リラックマ」主題歌「stay with me」を配信リリース",
      "description": "幾田りらがProduction I.G制作のTVアニメ「リラックマ」の主題歌「stay with me」を4月4日に配信リリース。温かみのあるアコースティックサウンドの書き下ろし楽曲で、幾田りら自身がナレーションも担当している。",
      "url": "https://skream.jp/news/2026/03/ikutalilas_stay_with_me.php",
      "category": "release",
      "added_at": "2026-04-10T03:00:00+00:00",
      "source": "skream.jp",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-10",
      "title": "久石譲とのコラボでゲーム『レイトン教授と蒸気の新世界』メインテーマ担当が決定",
      "description": "幾田りらが久石譲と共にゲームソフト「レイトン教授と蒸気の新世界」（2026年末に世界同時発売予定）のメインテーマ曲を制作することが4月10日22時に発表された。久石譲が作曲、幾田りらが作詞・ボーカルを担当する。",
      "url": "https://natalie.mu/music/news/667908",
      "category": "collab",
      "added_at": "2026-04-11T03:00:00+00:00",
      "source": "natalie.mu",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-10",
      "title": "「幾田りらのオールナイトニッポンGOLD」初単独パーソナリティ放送",
      "description": "幾田りらがニッポン放送「オールナイトニッポンGOLD」の初単独パーソナリティを担当し、4月10日22時〜24時に生放送された。YOASOBIボーカルとして番組に出演歴はあるが、単独でのパーソナリティ担当は今回が初めて。",
      "url": "https://natalie.mu/music/news/666893",
      "category": "other",
      "added_at": "2026-04-12T00:00:00Z",
      "source": "natalie.mu",
