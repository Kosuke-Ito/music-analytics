  "annotations": [
    {
      "date": "2026-04-03",
      "title": "結成30周年記念カセットテープコレクション詳細発表・抽選販売エントリー開始",
      "description": "BUMP OF CHICKENの結成30周年記念「CASSETTE TAPE COLLECTION」の詳細が発表され、4月6日18:00よりTOY'S STORE限定の抽選販売エントリーが開始（4月17日23:59締切）。全10枚のアルバムをカセット化し、オリジナルカセットプレーヤーも同時販売（音楽ナタリー・Realsound報道）。",
      "url": "https://natalie.mu/music/news/666890",
      "category": "release",
      "added_at": "2026-04-18T00:00:00Z",
      "source": "natalie.mu",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-21",
      "title": "数値上の異常上昇を検知（30周年記念施策との間接的関連の可能性）",
      "description": "Spotify月間リスナーが2,299,965→2,307,986（+8,020人・2.74σ）に急増。4月6日〜17日に実施された結成30周年記念「CASSETTE TAPE COLLECTION」抽選販売エントリー締切（4/17）後のSNS話題拡散が間接的に新規リスナーを呼び込んだ可能性があるが、4月21日固有の明確なメディア露出・リリースは特定できず。",
      "category": "other",
      "added_at": "2026-04-21T15:30:00+00:00",
      "source": "natalie.mu/music/news/666890",
      "confidence": "low"
    },
    {
      "date": "2026-04-25",
      "title": "結成30周年記念カセットテープコレクション（4/3発表）のSNS拡散継続でYouTube Music月間リスナー・YouTube総再生数が上昇（2.76σ/2.24σ）",
      "description": "4月3日発表・4月6日〜17日に抽選エントリーが行われた結成30周年記念「CASSETTE TAPE COLLECTION」（全10枚アルバムカセット化＋オリジナルカセットプレーヤー）の話題がSNSで継続拡散し、YouTube Music月間リスナーが8,702,500から8,920,000へ+217,500（2.76σ）、YouTube総再生数も1,760,335,611から1,772,184,419へ+11,848,808（2.24σ）上昇した。",
      "url": "https://natalie.mu/music/news/666890",
      "category": "release",
      "added_at": "2026-04-25T15:00:00Z",
      "source": "natalie.mu",
      "confidence": "medium",
      "verified": false
    },
    {
      "date": "2026-04-29",
      "title": "30周年記念施策継続＋ドームツアー追加公演でYTM月間リスナーが急増（+483,125・2.9σ）",
      "description": "結成30周年記念カセットテープコレクション（4/3発表）の話題継続と、「TOUR 2026-2027 Ratio Clavis」への東京ドーム・京セラドーム追加公演発表・サマーソニック東京初出演決定（2/13）の複合効果が持続し、YouTube Music月間リスナーが8,786,875→9,270,000（+483,125・2.9σ）に急増した。",
      "category": "tour",
      "added_at": "2026-04-29T16:00:00Z",
      "source": "natalie.mu / bumpofchicken.com",
      "confidence": "medium"
    }
  ],
