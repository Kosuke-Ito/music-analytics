  "annotations": [
    {
      "date": "2026-04-15",
      "title": "ライブ映像作品「MAD HOPE MAD MUSIC」がNetflixで独占配信開始",
      "description": "星野源の全国ツアー「Gen Hoshino presents MAD HOPE」大阪城ホール公演（2025年6月25日）を収録した特別編集版ライブ映像「Gen Hoshino presents MAD HOPE MAD MUSIC」が、4月15日よりNetflixで独占配信開始。全24曲収録で、Blu-ray/DVD発売（4月22日）の1週間前配信（音楽ナタリー報道）。",
      "url": "https://natalie.mu/music/news/666838",
      "category": "release",
      "added_at": "2026-04-16T03:00:00+00:00",
      "source": "natalie.mu",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-20",
      "title": "Blu-ray/DVDトレーラー公開（4/17）とNetflix配信効果継続でYouTube総再生数が急増（2.44σ）",
      "description": "4月22日リリース予定のLive Blu-ray/DVD「Gen Hoshino presents MAD HOPE Japan Tour」のトレーラー映像が4月17日に公式YouTubeで公開（音楽ナタリー報道）。発売直前のプロモーション効果と、4月15日開始のNetflix独占配信「MAD HOPE MAD MUSIC」による継続的な関心増が重なり、YouTube総再生数が1,402,771,497→1,404,957,040（+2,185,542・2.44σ）に急増した。",
      "category": "release",
      "added_at": "2026-04-20T15:00:00+00:00",
      "source": "natalie.mu/music/news/668774",
      "confidence": "medium"
    },
    {
      "date": "2026-04-22",
      "title": "Live Blu-ray/DVD「Gen Hoshino presents MAD HOPE Japan Tour」発売",
      "description": "星野源のライブ映像作品「Gen Hoshino presents MAD HOPE Japan Tour」がBlu-ray・DVDで4月22日に発売。2025年の全国ツアーを収録した作品で、4月15日にNetflixで先行配信された「MAD HOPE MAD MUSIC」（大阪城ホール公演）を含む完全版ツアー映像。初回限定盤にはフォトブック封入（音楽ナタリー報道）。",
      "url": "https://natalie.mu/music/news/668774",
