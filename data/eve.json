  "annotations": [
    {
      "date": "2026-04-06",
      "title": "TVアニメ「とんがり帽子のアトリエ」OPテーマ「風のアンセム feat. suis from ヨルシカ」初オンエア",
      "description": "4月6日放送開始のTVアニメ「とんがり帽子のアトリエ」のオープニングテーマとして、Eveとヨルシカのsuisがコラボした「風のアンセム」が初オンエア。音源の配信リリースは4月14日（Real Sound・音楽ナタリー報道）。",
      "url": "https://realsound.jp/2026/04/post-2358624.html",
      "category": "release",
      "added_at": "2026-04-13T03:00:00+00:00",
      "source": "realsound.jp",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-14",
      "title": "「風のアンセム feat. suis from ヨルシカ」配信リリース＆ノンクレジットOP映像公開",
      "description": "TVアニメ「とんがり帽子のアトリエ」OPテーマ「風のアンセム feat. suis from ヨルシカ」が4月14日に各ストリーミングサービスで配信リリース。アニメのノンクレジットOP映像もYouTubeで同日公開された（natalie.mu・Billboard JAPAN報道）。",
      "url": "https://natalie.mu/music/news/668185",
      "category": "release",
      "added_at": "2026-04-15T03:00:00+00:00",
      "source": "natalie.mu",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-20",
      "title": "アニメ「とんがり帽子のアトリエ」ABEMA一挙放送・地上波放送でYouTube総再生数が急増（2.55σ）",
      "description": "4月14日公開のノンクレジットOP映像「風のアンセム feat. suis from ヨルシカ」の波及効果が持続。4月18日（土）にABEMAで第1〜3話の無料振り返り一挙放送が実施され、4月20日（月）にTOKYO MXほかで第3話の地上波放送が行われたことで視聴者が再増加。YouTube総再生数が3,393,350,253→3,421,045,823（+27,695,570・2.55σ）に急増した。Eve×ヨルシカsuis×BUG FILMSによる豪華コラボが話題を集めており、アニメ放送のたびにOP映像への再アクセスが増加したとみられる。",
      "category": "viral",
      "added_at": "2026-04-20T15:00:00+00:00",
      "source": "natalie.mu/music/news/668185",
      "confidence": "high"
    }
  ],
