  "annotations": [
    {
      "date": "2026-04-04",
      "title": "「THE MUSIC STADIUM 2026」国立競技場公演 Day1開催（UVERworldと共演）",
      "description": "ONE OK ROCK主催「docomo presents THE MUSIC STADIUM 2026」の初日公演をMUFGスタジアム（国立競技場）で開催。UVERworldとの2マン形式で行われ、アンコールではTakuya∞をフィーチャーした楽曲を披露した。",
      "url": "https://www.oneokrock.com/jp/news/4924",
      "category": "tour",
      "added_at": "2026-04-05T00:00:00+00:00"
    },
    {
      "date": "2026-04-05",
      "title": "「THE MUSIC STADIUM 2026」国立競技場公演 Day2開催（YOASOBIと共演）",
      "description": "ONE OK ROCK主催イベント2日目をYOASOBIとの2マン形式で開催。同イベントは国立競技場の民間移行を記念したプロジェクト「KOKURiTSU NEXT」の一環。",
      "url": "https://www.oneokrock.com/jp/news/4924",
      "category": "tour",
      "added_at": "2026-04-05T00:00:00+00:00"
    },
    {
      "date": "2026-04-14",
      "title": "映画『DETOX IN CINEMAS』公開前に「The Beginning」ライブ映像解禁",
      "description": "4月17日公開の映画『ONE OK ROCK DETOX JAPAN TOUR 2025 AT NISSAN STADIUM IN CINEMAS』のプロモーションとして、横浜・日産スタジアム公演での「The Beginning」演奏シーンのライブ映像が解禁。Billboard Japan・cinemacafe等の主要メディアで一斉報道され、Spotify月間リスナー+44,057（2.32σ）・YouTube総再生数+905万（2.48σ）の急増につながった。",
      "url": "https://www.billboard-japan.com/d_news/detail/160508",
      "category": "release",
      "added_at": "2026-04-15T14:00:00+00:00",
      "source": "billboard-japan.com / cinemacafe.net",
      "confidence": "high",
      "verified": true
    }
  ],
