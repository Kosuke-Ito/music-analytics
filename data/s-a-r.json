  "annotations": [
    {
      "date": "2026-04-08",
      "title": "新曲「Daylight」配信リリース＆台北全編撮影MV公開",
      "description": "首都医校・大阪医専・名古屋医専の2026年新TVCMソングに起用された新曲「Daylight」を4月8日に配信リリース。MVは全編台北で撮影。同時に5月27日リリースの2ndアルバム「Be Kool Rewind」も発表（Billboard JAPAN報道）。",
      "url": "https://www.billboard-japan.com/d_news/detail/160288",
      "category": "release",
      "added_at": "2026-04-13T03:00:00+00:00",
      "source": "billboard-japan.com",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-16",
      "title": "「allumage vol.3」に出演（渋谷TOKIO TOKYO）",
      "description": "S.A.R.がbrkfstblend、E.sceneと共演する東京・渋谷TOKIO TOKYOの音楽イベント「allumage vol.3」に出演し、40分のロングセットを披露した。",
      "url": "https://spincoaster.com/news/allumage-vol-3",
      "category": "tour",
      "added_at": "2026-04-18T00:00:00Z",
      "source": "spincoaster.com",
      "confidence": "medium",
      "verified": false
    }
