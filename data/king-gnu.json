  "annotations": [
    {
      "date": "2026-03-31",
      "title": "ライブ映像「AIZO」を公式公開（CEN+RAL Tour 2026 有明アリーナ）",
      "description": "「King Gnu CEN+RAL Tour 2026」東京・有明アリーナ公演（3/18〜19）より「AIZO」のライブ映像が公式チャンネルにて公開された。",
      "url": "https://tower.jp/article/news/2026/03/31/tg022",
      "category": "release",
      "added_at": "2026-04-06T00:00:00+00:00"
    },
    {
      "date": "2026-04-05",
      "title": "CEN+RAL Tour 2026 広島グリーンアリーナ公演2日目を開催",
      "description": "「King Gnu CEN+RAL Tour 2026」広島グリーンアリーナの2日目公演を開催。バンド史上最大規模となる全国16都市を巡るアリーナツアーの一環。",
      "url": "https://www.sonymusic.co.jp/artist/kinggnu/info/577778",
      "category": "tour",
      "added_at": "2026-04-07T03:30:00+00:00",
      "source": "sonymusic.co.jp",
      "confidence": "medium",
      "verified": false
    },
    {
      "date": "2026-04-14",
      "title": "CEN+RAL Tour 2026 ラ・ラ アリーナ東京ベイ公演（初日）",
      "description": "「King Gnu CEN+RAL Tour 2026」千葉・ラ・ラ アリーナ東京ベイ公演の1日目を開催。史上最多公演数となる全国15都市29公演のアリーナツアーの一環で、翌15日にも同会場で2日目公演を実施。本ツアーではスマートフォンによる撮影・録画が条件付きで解禁されている。",
      "url": "https://www.sonymusic.co.jp/artist/kinggnu/info/577778",
      "category": "tour",
      "added_at": "2026-04-15T03:00:00+00:00",
      "source": "sonymusic.co.jp",
      "confidence": "medium",
      "verified": false
    },
    {
      "date": "2026-04-15",
      "title": "CEN+RAL Tour 2026 ラ・ラ アリーナ東京ベイ公演（2日目）",
      "description": "「King Gnu CEN+RAL Tour 2026」千葉・ラ・ラ アリーナ東京ベイ公演の2日目を開催。2日連続公演によりYouTube総再生数が+1,259万回（4.1σ）の急増を記録。スマートフォン撮影・SNS共有を条件付きで解禁した本ツアーの特性も後押しし、2日間を通じたファンの視聴活動が活発化したとみられる。",
      "url": "https://lalaarenatokyo-bay.com/event/2042/",
      "category": "tour",
      "added_at": "2026-04-15T14:00:00+00:00",
      "source": "lalaarenatokyo-bay.com",
      "confidence": "medium",
      "verified": false
    }
