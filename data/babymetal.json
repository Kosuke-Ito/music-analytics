  "annotations": [
    {
      "date": "2026-04-01",
      "title": "FOX DAY 2026年活動予定発表・デラックスアルバム＆北米ツアー決定",
      "description": "4月1日の「FOX DAY」に2026年の活動予定を発表。初のデラックスアルバム『METAL FORTH (DELUXE EDITION)』の6月26日全世界リリースが決定し、北米・中南米ワールドツアーも発表（ユニバーサルミュージック・音楽ナタリー報道）。",
      "url": "https://natalie.mu/music/news/666424",
      "category": "release",
      "added_at": "2026-04-13T03:00:00+00:00",
      "source": "natalie.mu",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-04",
      "title": "SiM主催「DEAD POP FESTiVAL 2026」に出演",
      "description": "SiM主催フェス「DEAD POP FESTiVAL 2026」（川崎市東扇島東公園特設会場）にBABYMETALが出演。マキシマム ザ ホルモンのナヲ（姉メタル）が「ギミチョコ!!」でゲスト参加するなど話題を集めた（BABYMETAL TIMES報道）。",
      "url": "https://babymetaltimes.com/archives/270910.html",
      "category": "tour",
      "added_at": "2026-04-13T03:00:00+00:00",
      "source": "babymetaltimes.com",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-17",
      "title": "「from me to u (Major Lazer Remix)」配信リリース＆リリックビデオ公開",
      "description": "デラックスアルバム「METAL FORTH (DELUXE EDITION)」の第一弾先行トラックとして、Major Lazerがリミックスした「from me to u (Major Lazer Remix)」を4月17日に全世界配信リリース。リリックビデオも同日公開（ユニバーサルミュージック・音楽ナタリー報道）。",
      "url": "https://www.universal-music.co.jp/babymetal/news/2026-04-17/",
      "category": "release",
      "added_at": "2026-04-18T00:00:00Z",
      "source": "universal-music.co.jp",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-24",
      "title": "ラテンアメリカツアー先行（4/20-22）でメキシコ公演が24時間以内完売、世界的話題でYouTube Music月間リスナーが急増（7.55σ）",
      "description": "4月20〜22日に開始したラテンアメリカツアーの先行チケット販売において、メキシコ公演のスタンド席・VIPパッケージが一般発売前に24時間以内で完売（残留は一般エリアのみ）。BABYMETALがグローバル第2位の市場であるメキシコでの高需要がSNSで拡散し、YouTube Music月間リスナーが6,505,000人から6,930,000人へ+425,000人（7.55σ）急増した。",
      "url": "https://www.babymetal-darake.com/entry/2026/04/22/201100/47409/",
      "category": "tour",
      "added_at": "2026-04-25T15:00:00Z",
      "source": "babymetaltimes.com / babymetal-darake.com",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-25",
      "title": "ラテンアメリカツアー完売反響継続とMajor Lazer Remix波及でYTM月間リスナー＋YouTube総再生数が急増（2.91σ・2.24σ）",
      "description": "メキシコ公演24時間完売（4/22）の反響がSNSで継続拡散し、YouTube Music月間リスナーが6,930,000→7,414,000（+484,000・2.91σ）に急増。並行して4月17日配信の「from me to u (Major Lazer Remix)」へのアクセスが波及し、YouTube総再生数も+3,917,943（2.24σ）増加した。",
      "category": "tour",
      "added_at": "2026-04-27T15:30:00+00:00",
      "source": "babymetaltimes.com, universal-music.co.jp/babymetal",
      "confidence": "medium"
    }
  ],
