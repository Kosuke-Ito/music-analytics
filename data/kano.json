  "annotations": [
    {
      "date": "2026-04-03",
      "title": "1st EP収録曲「Day＆Night」先行配信・テレ朝EDテーマ決定",
      "description": "4月15日リリース予定の1st EP『トキメキ詐欺 - EP』より「Day＆Night」が先行配信開始。テレビ朝日「永野＆くるまのひっかかりニーチェ」4月度エンディングテーマにも決定した。",
      "url": "https://skream.jp/news/2026/04/kano_day-and-night_release.php",
      "category": "release",
      "added_at": "2026-04-12T00:00:00Z",
      "source": "skream.jp",
      "confidence": "high",
      "verified": false
    },
    {
      "date": "2026-04-15",
      "title": "1st EP「トキメキ詐欺 - EP」リリース",
      "description": "元GANG PARADEの華乃が初のEP「トキメキ詐欺 - EP」を4月15日にリリース。甘さとほろ苦さが交錯する恋心を多面的に描いた全5曲入りで、リード曲「トキメキ詐欺」はボカロP・東京真中が手掛けた（音楽ナタリー報道）。",
      "url": "https://natalie.mu/music/news/659397",
      "category": "release",
      "added_at": "2026-04-16T03:00:00+00:00",
      "source": "natalie.mu",
